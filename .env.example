# ─── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://moduwa:moduwa@localhost:5432/moduwa

# ─── 공공데이터포털 / TourAPI ─────────────────────────────────
# 한국관광공사 관광지별 연관관광지 정보 (TarRlteTarService1)
# ⚠️ "디코딩" 키. (이 서비스키는 hex라 인코딩/디코딩 동일)
DATA_GO_KR_SERVICE_KEY=여기에_서비스키
MOBILE_APP=moduwa
MOBILE_OS=ETC

# 엔드포인트 (기본값이 areaBasedList1이라 보통 그대로 둠)
# TARRLTE_BASE_URL=http://apis.data.go.kr/B551011/TarRlteTarService1/areaBasedList1

# ─── 수집 범위 (기준연월) ─────────────────────────────────────
# 실제 데이터 가용범위: 202405 ~ 202605
BASE_YM_START=202405
BASE_YM_END=202605

# ─── 수집 튜닝 ───────────────────────────────────────────────
INGEST_NUM_OF_ROWS=5000        # 시군구당 보통 1요청으로 끝나도록 크게
INGEST_REQUEST_DELAY_MS=150    # 호출 간 딜레이(ms)
INGEST_MAX_RETRIES=5           # 페이지 실패 시 재시도

# 일일 요청 상한 (개발계정 1,000/일). 여유 두고 자동 중단 → 다음날 재개.
# 0 = 무제한(API 한도초과 에러에 의존)
INGEST_DAILY_REQUEST_CAP=900

# KorService2 상세 enrich 대상 유형. 기본=가볼곳만(개요·운영시간 가치高), 상업유형 제외.
# 12관광지 14문화시설 28레포츠 15축제 25여행코스 / (상업)32숙박 38쇼핑 39음식점
# 전체 원하면: 12,14,28,15,25,32,38,39
KORDETAIL_CONTENT_TYPES=12,14,28,15,25

# ─── 카카오 로컬 API (전화·카테고리·지도링크 보완) ───────────
# 발급: developers.kakao.com → 내 애플리케이션 → 앱 생성 → 앱 키 → REST API 키
KAKAO_REST_API_KEY=여기에_카카오_REST_API_키
KAKAO_DAILY_CAP=90000          # 카카오 무료 10만/일
KAKAO_CONCURRENCY=8            # 동시 요청 수

# ─── REST API 서버 (배포용) ──────────────────────────────────
PORT=8080
# 허용할 API 키 목록(콤마 구분). ⚠️ 배포 시 반드시 설정 — 비면 인증 없이 열림(로컬 개발 전용).
#   키 생성: node scripts/gen-api-key.mjs
API_KEYS=키1,키2
# CORS 허용 오리진(콤마 구분). 브라우저에서 직접 호출할 때만 의미. 서버간 호출이면 * 무방.
ALLOWED_ORIGINS=*
# API 키당 분당 요청 상한
RATE_LIMIT_PER_MIN=120

# ─── 사용자 로그인(계정 세션) ────────────────────────────────
# 대시보드 로그인과 다른 것이다. 저쪽은 운영자용 비밀번호 하나, 이쪽은 앱 사용자 계정이다.
# 세션 유효기간(일). 슬라이딩 — 쓰는 동안은 계속 연장된다.
SESSION_DAYS=90
# 절대 만료(일). 생성 시각 기준 상한. 슬라이딩만 두면 유출된 토큰이 무기한 유효해진다.
SESSION_MAX_DAYS=180
# 로그인·가입 시도 상한(10분 창, IP 기준)
MAX_LOGIN_ATTEMPTS=10
# ⚠️ 신뢰하는 프록시 홉 수. 클라이언트 IP 를 X-Forwarded-For 의 **오른쪽에서** 이만큼 세어 얻는다.
#   Railway·Render 등 프록시 뒤 배포 = 1 (기본값).
#   프록시 없이 직접 노출(로컬 개발, docker compose) = **0** — 0 은 XFF 를 아예 무시한다.
#   이 값이 실제 구성보다 크면 위 시도 제한이 헤더 한 줄로 우회된다. 프록시가 늘면 함께 올릴 것.
TRUSTED_PROXY_HOPS=1

# ─── 소셜 로그인 (애플 · 구글) ────────────────────────────────
# ⚠️ 비밀이 아니다. 클라이언트 ID·번들 ID 는 앱 바이너리에 들어 있어 누구나 읽을 수 있다.
#   서버가 알아야 하는 이유는 하나 — 받은 ID 토큰의 `aud` 가 **우리 앱 것인지** 확인해야 한다.
#   이것 없이 서명만 확인하면 남의 앱에 발급된 토큰으로도 로그인이 된다(계정 탈취).
# **비워 두면 그 프로바이더 로그인은 503 으로 거부된다.** "전부 통과"보다 안전한 기본값이다.
#
# 구글 iOS 클라이언트 ID (Google Cloud Console → 사용자 인증 정보 → OAuth 클라이언트 ID → iOS).
#  콤마로 여러 개 — 안드로이드·웹 클라이언트를 따로 만들면 aud 가 서로 다르다.
GOOGLE_CLIENT_IDS=
# 네이티브 Sign in with Apple 의 aud = **앱 번들 ID**(com.waasegye.moduwa).
#  웹 플로우를 붙이면 Service ID 도 콤마로 함께.
APPLE_CLIENT_IDS=
# 카카오 ID 토큰의 aud = **앱 키**(클라이언트 ID 가 아니다).
#  SDK 로그인은 네이티브 앱 키, REST 로그인은 REST API 키. 둘 다 쓰면 쉼표로 나열한다.
#  ⚠️ 카카오 개발자 콘솔에서 **OpenID Connect 를 활성화**해야 id_token 이 발급된다.
#     켜지 않으면 앱은 access_token 만 받고 이 로그인 경로가 시작되지 않는다.
KAKAO_APP_KEYS=

# ─── 메일 발송 (이메일 인증 · 비밀번호 재설정) ────────────────
# ⚠️ 비우면 **실제로 보내지 않고 콘솔에 찍는다.** 로컬 개발에서는 그게 편하다 —
#   메일함을 열지 않고 터미널에서 인증 코드를 바로 복사할 수 있다.
#   배포에서는 반드시 설정해야 한다. 없으면 사용자가 비밀번호를 잊었을 때 복구 불가.
RESEND_API_KEY=
# ⚠️ Resend 에 등록한 발송 도메인과 **반드시** 일치해야 한다.
#   등록 도메인이 mail.moduwa.app 이므로 noreply@moduwa.app 로 보내면 DKIM 정렬이 깨져
#   스팸함으로 간다. 반드시 @mail.moduwa.app 를 쓸 것.
MAIL_FROM=모두와 <noreply@mail.moduwa.app>
# 인증·재설정 코드 유효시간(분). 너무 짧으면 메일이 도착하기 전에 만료된다
# (국내 수신 서버가 스팸 판정으로 몇 분 지연시키는 경우가 있다).
EMAIL_CODE_MINUTES=10

# ─── 수집 현황 대시보드 (/dashboard) ─────────────────────────
# 비우면 라우트를 아예 열지 않는다(= 실수로 무인증 대시보드가 노출되지 않음).
# 로그인 폼 + HMAC 서명 쿠키. 비밀번호를 바꾸면 발급된 세션이 전부 무효가 된다.
DASHBOARD_PASSWORD=
# 세션 서명 키(선택). 비우면 비밀번호에서 파생.
# DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_HOURS=12
# 집계·조회 1건당 상한 — 큰 테이블이 페이지를 붙잡지 않도록.
DASHBOARD_QUERY_TIMEOUT_MS=8000
DASHBOARD_QUERY_ROW_LIMIT=500

# ─── 관리형 DB 동기화 (선택) ─────────────────────────────────
# 설정하면 daily-ingest.sh 가 매일 수집 후 "API용 슬림 테이블"만 관리형 DB로 push한다.
# (무거운 수집 원본은 로컬에만 유지 → 관리형 디스크 절약). 값은 관리형 DB의 공개 URL.
# ⚠️ 관리형 DB 비밀번호를 로테이트하면 이 값도 갱신해야 한다.
# MANAGED_DATABASE_URL=postgresql://postgres:...@xxx.proxy.rlwy.net:포트/railway
